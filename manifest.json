{
  "manifest_version": 3,
  "name": "LiveLayer Sports Overlay",
  "version": "0.8.0",
  "description": "Tab-specific, customizable ESPN and Kalshi widgets over webpage video.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://site.api.espn.com/*",
    "https://external-api.kalshi.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LiveLayer controls",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "Show or hide LiveLayer overlays"
    },
    "open-controls": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open LiveLayer overlay controls"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/widget-utils.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
